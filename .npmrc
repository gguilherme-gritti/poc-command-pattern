# Configurações do npm/pnpm para o projeto
# Utilize este arquivo para definir variáveis de ambiente como:
# - registry privado (ex: registry=https://npm.pkg.github.com)
# - tokens de autenticação (ex: //npm.pkg.github.com/:_authToken=${NPM_TOKEN})
# - configurações específicas do projeto

# Garante resolução estrita de peer dependencies
strict-peer-dependencies=false
